v5.db.transport.rest {
	encode zstd gzip
	route / {
		rate_limit {
			key {remote.ip}
			events 60
			window 1m
		}
	}
	reverse_proxy /* {
		to http://localhost:3008

		lb_policy round_robin
		lb_try_duration 10s
		fail_duration 1m
		max_fails 5
		health_uri /health
		health_interval 5m
		health_timeout 10s
	}
	log {
		output file /var/log/caddy/v5.db.transport.rest.log {
			roll_keep_for 10000h
		}
		format filter {
			request>remote_ip,request>client_ip ip_mask 24 56
		}
	}
}
a.v5.db.transport.rest {
	encode zstd gzip
	route / {
		rate_limit {
			key {remote.ip}
			events 60
			window 1m
		}
	}
	reverse_proxy /* http://localhost:3008 {
	}
	log {
		output file /var/log/caddy/a.v5.db.transport.rest.log {
			roll_keep_for 10000h
		}
		format filter {
			request>remote_ip,request>client_ip ip_mask 24 56
		}
	}
}
